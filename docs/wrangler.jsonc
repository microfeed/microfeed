{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "microfeed-docs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "docs.microfeed.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "preview": {
      "name": "microfeed-docs-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": []
    }
  }
}
