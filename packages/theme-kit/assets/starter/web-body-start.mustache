<header class="mf-site-header">
  <a class="mf-site-title" href="{{home_page_url}}">{{title}}</a>
  <button type="button" aria-haspopup="dialog" aria-controls="microfeed-search-dialog" data-microfeed-search-open>Search</button>
  <nav class="mf-site-navigation" aria-label="Site navigation">
    {{#navigation_pages}}
    <a href="{{url}}" data-microfeed-nav-item>{{navigation_label}}</a>
    {{/navigation_pages}}
  </nav>
</header>
