<title>{{title}}</title>
<style>
  :root {
    --mf-accent: #0969da;
    --mf-background: Canvas;
    --mf-surface: color-mix(in srgb, CanvasText 5%, Canvas);
    --mf-text: CanvasText;
    --mf-muted: GrayText;
    --mf-border: color-mix(in srgb, CanvasText 20%, transparent);
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
  }
  body { margin: 0; background: var(--mf-background); color: var(--mf-text); }
  .mf-site-header { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--mf-border); }
  .mf-site-title { margin-right: auto; font-weight: 700; }
  .mf-site-navigation { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  main { margin: auto; max-width: 48rem; padding: 2rem 1rem; }
  article { border-bottom: 1px solid var(--mf-border); padding: 1rem 0; }
  img, video { height: auto; max-width: 100%; }
  [data-microfeed-search-scope] { display: grid; gap: 0.75rem; }
  .mf-public-search-result__details {
    display: -webkit-box;
    margin: 0.25rem 0 0;
    overflow: hidden;
    color: var(--mf-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .mf-public-search-result__details mark { background: color-mix(in srgb, var(--mf-accent) 18%, transparent); color: inherit; }
  @media (max-width: 40rem) {
    .mf-site-header { align-items: flex-start; flex-wrap: wrap; }
    .mf-site-navigation { flex-basis: 100%; }
  }

.mf-item-tags{display:flex;flex-wrap:wrap;gap:.4rem;list-style:none;margin:.65rem 0;padding:0;font-size:.85rem}.mf-item-tags li{margin:0;max-width:100%}.mf-item-tags a{display:inline-block;padding:.15rem .5rem;border:1px solid var(--mf-border);border-radius:1rem;color:var(--mf-accent);overflow-wrap:anywhere;cursor:pointer}.mf-item-tags a:focus-visible{outline:2px solid var(--mf-accent);outline-offset:2px}
.mf-item-tags a::before { content: ""; display: inline-block; width: 1em; height: 1em; margin-inline-end: .3em; vertical-align: -.15em; background-color: currentColor; mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22black%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%203h8l10%2010-8%208L3%2011Z%22%2F%3E%3Ccircle%20cx%3D%227.5%22%20cy%3D%227.5%22%20r%3D%221.5%22%2F%3E%3C%2Fsvg%3E") center / contain no-repeat; }

.mf-tag-discovery { box-sizing: border-box; width: 100%; max-width: 70rem; margin: 2rem auto; padding: 1.5rem 0; border-top: 1px solid var(--mf-border); color: var(--mf-text); }
.mf-tag-discovery-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; }
.mf-tag-discovery h2 { margin: 0; font-size: 1rem; font-weight: 650; }
.mf-tag-discovery-heading a { color: var(--mf-accent); font-size: .875rem; text-decoration: none; cursor: pointer; }
.mf-tag-discovery a:focus-visible { outline: 2px solid var(--mf-accent); outline-offset: 3px; }
.mf-tag-discovery .mf-item-tags { margin-bottom: 0; }

.mf-tag-header { margin: 0 0 2rem; padding: 0; }

.mf-tag-header h1 { margin: 0; font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.2; overflow-wrap: anywhere; }
.mf-tag-description { margin: .75rem 0 0; color: var(--mf-muted); white-space: pre-line; overflow-wrap: anywhere; }
.mf-tag-subscriptions { display: flex; flex-wrap: wrap; gap: .75rem; width: 100%; max-width: 70rem; box-sizing: border-box; margin: .75rem 0; padding: 0; font-size: .875rem; }
</style>
