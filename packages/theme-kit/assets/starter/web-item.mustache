<main class="mf-item">
  {{#items.0}}<article><h1>{{title}}</h1>
    {{#authors.length}}<p aria-label="Authors">By {{#authors}}<span>{{#url}}<a href="{{url}}" rel="author">{{name}}</a>{{/url}}{{^url}}{{name}}{{/url}} </span>{{/authors}}</p>{{/authors.length}}
    {{{content_html}}}{{^content_html}}<p>{{content_text}}</p>{{/content_html}}</article>{{/items.0}}
</main>
