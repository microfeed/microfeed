{
  "name": "@microfeed/cli",
  "version": "1.0.1",
  "description": "Manage content on a microfeed instance",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "microfeed": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "microfeed": "node --import tsx src/index.ts",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
