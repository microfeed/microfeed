---
import {env} from "cloudflare:workers";

import AdminHomeApp from "@/components/admin/home/AdminHomeApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import PublicLayout from "@/layouts/PublicLayout.astro";
import {NAV_ITEMS} from "@/shared/Constants";
import {normalizeAdminPath} from "@/shared/AdminPath";
import {loadPublicPageRoute} from "@/server/pages/public";
import {listContactMessages} from "@/server/contact/service";

const routeAdminPath = Astro.params.adminPath ?? "";
const adminRequest = routeAdminPath === normalizeAdminPath(
  env.MICROFEED_ADMIN_PATH,
);
const AdminShell = adminRequest
  ? (await import("../../layouts/AdminShell.astro")).default
  : undefined;
const {feedContent, onboardingResult} = Astro.locals;
const contactMessages = adminRequest
  ? await listContactMessages(env.FEED_DB)
  : [];
let publicPage;
if (adminRequest && (!feedContent || !onboardingResult)) {
  throw new Error("Admin feed context was not initialized.");
}
if (!adminRequest) {
  publicPage = await loadPublicPageRoute(env, Astro.request, routeAdminPath);
  if (publicPage.kind === "redirect") {
    return Astro.redirect(publicPage.location, 301);
  }
  if (publicPage.kind === "not-found") {
    Astro.response.status = 404;
  } else if (publicPage.kind === "page") {
    Astro.response.status = publicPage.status;
  }
}
---

{adminRequest && AdminShell ? (
  <AdminShell
    activeNavItem={NAV_ITEMS.ADMIN_HOME}
    documentTitle="Admin | microfeed.org"
    feedContent={feedContent!}
    onboardingResult={onboardingResult!}
    pageTitle="Home"
  >
    <AdminHomeApp client:only="react" contactMessages={contactMessages} feedContent={feedContent!} onboardingResult={onboardingResult!}>
      <AdminPageFallback slot="fallback" kind="home" />
    </AdminHomeApp>
  </AdminShell>
) : publicPage?.kind === "page" ? (
  <PublicLayout {...publicPage.layout} />
) : (
  <h1>Not Found</h1>
)}
