---
import EditItemApp from "@/components/admin/items/EditItemApp";
import AdminPageFallback from "@/components/admin/AdminPageFallback.astro";
import AdminShell from "../../../../layouts/AdminShell.astro";
import {env} from "cloudflare:workers";
import {listCategories} from "@/server/categories/service";

const {feedContent, onboardingResult} = Astro.locals;
if (!feedContent || !onboardingResult) {
  throw new Error("Admin feed context was not initialized.");
}
const categories = await listCategories(env.FEED_DB);
---

<AdminShell
  activeNavItem={null}
  documentTitle="New item | microfeed.org"
  {feedContent}
  {onboardingResult}
  pageTitle="Add new item"
>
  <EditItemApp client:only="react" categories={categories} {feedContent} {onboardingResult}>
    <AdminPageFallback slot="fallback" kind="form" />
  </EditItemApp>
</AdminShell>
