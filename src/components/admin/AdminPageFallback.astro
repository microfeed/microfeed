---
interface Props {
  kind: "editor" | "form" | "home" | "list" | "settings";
  label?: string;
}

const {kind, label = "Loading admin page"} = Astro.props;
const rowCounts = {
  editor: 12,
  form: 9,
  home: 6,
  list: 8,
  settings: 10,
};
---

<div
  class:list={[
    "admin-page-fallback w-full",
    `admin-page-fallback--${kind}`,
  ]}
  role="status"
  aria-busy="true"
  aria-live="polite"
>
  <span class="sr-only">{label}</span>
  <div class="h-8 w-48 rounded bg-gray-200"></div>
  <div class="mt-8 grid gap-6" aria-hidden="true">
    {
      Array.from({length: rowCounts[kind]}).map((_, index) => (
        <div
          class:list={[
            "rounded border border-gray-200 bg-white p-5",
            kind === "home" && index < 2 ? "min-h-36" : "min-h-20",
            kind === "editor" && index === 1 ? "min-h-72" : "",
          ]}
        >
          <div class="h-4 w-1/3 rounded bg-gray-200"></div>
          <div class="mt-4 h-3 w-full rounded bg-gray-100"></div>
          <div class="mt-2 h-3 w-4/5 rounded bg-gray-100"></div>
        </div>
      ))
    }
  </div>
</div>
