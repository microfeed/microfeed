---
import {
  HouseIcon,
  ListIcon,
  LogOutIcon,
  MenuIcon,
  PencilIcon,
  PlusIcon,
  SettingsIcon,
  XIcon,
  type LucideIcon,
} from "lucide-react";

type AdminIconName =
  | "bars"
  | "close"
  | "home"
  | "list"
  | "logout"
  | "pencil"
  | "plus"
  | "settings";

interface Props {
  class?: string;
  name: AdminIconName;
}

const {class: className, name} = Astro.props;
const icons: Record<AdminIconName, LucideIcon> = {
  bars: MenuIcon,
  close: XIcon,
  home: HouseIcon,
  list: ListIcon,
  logout: LogOutIcon,
  pencil: PencilIcon,
  plus: PlusIcon,
  settings: SettingsIcon,
};
const Icon = icons[name];
---

<Icon aria-hidden="true" className={className} />
