<dialog class="mf-public-search" data-microfeed-search-dialog data-search-endpoint="/search.json">
  <form action="/search/" method="get" class="mf-public-search__panel">
    <div class="mf-public-search__header">
      <label for="microfeed-search-dialog-input">Search this site</label>
      <button type="button" aria-label="Close search" data-microfeed-search-close>Close</button>
    </div>
    <div class="mf-public-search__input-row">
      <input id="microfeed-search-dialog-input" name="q" type="search" autocomplete="off" data-microfeed-search-input />
      <button type="submit">Search</button>
    </div>
    <div class="mf-public-search__results" aria-live="polite" data-microfeed-search-results></div>
  </form>
</dialog>

<style is:global>
  .mf-public-search {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(38rem, calc(100vh - 2rem));
    padding: 0;
    border: 1px solid #d0d7de;
    border-radius: 0.75rem;
    background: Canvas;
    color: CanvasText;
    box-shadow: 0 1rem 4rem rgb(0 0 0 / 22%);
  }
  .mf-public-search::backdrop { background: rgb(0 0 0 / 45%); }
  .mf-public-search__panel { padding: 1rem; }
  .mf-public-search__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .mf-public-search__header label { font-weight: 700; }
  .mf-public-search button { cursor: pointer; }
  .mf-public-search input[type="search"],
  [data-microfeed-search-input] {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid #8c959f;
    border-radius: 0.45rem;
    background: Canvas;
    color: CanvasText;
    font: inherit;
  }
  .mf-public-search__input-row {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }
  .mf-public-search__input-row input[type="search"] { min-width: 0; }
  .mf-public-search__input-row button[type="submit"] {
    padding: 0.7rem 1rem;
    border: 1px solid #8c959f;
    border-radius: 0.45rem;
    background: ButtonFace;
    color: ButtonText;
    font: inherit;
  }
  .mf-public-search__results { overflow: auto; margin-top: 0.75rem; }
  .mf-public-search-result {
    display: block;
    padding: 0.7rem;
    border-radius: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .mf-public-search-result:hover,
  .mf-public-search-result:focus-visible { background: color-mix(in srgb, CanvasText 8%, Canvas); }
  .mf-public-search-result__type {
    margin-left: 0.45rem;
    color: GrayText;
    font-size: 0.8em;
    text-transform: capitalize;
  }
  .mf-public-search-message { padding: 0.75rem; color: GrayText; }
</style>

<script>
  interface SearchResult {
    content_text?: string;
    title: string;
    type: "item" | "page";
    url: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-microfeed-search-dialog]",
  );
  const endpoint = dialog?.dataset.searchEndpoint ?? "/search.json";
  let controller: AbortController | undefined;

  function resultContainer(input: HTMLInputElement): HTMLElement | null {
    const scope = input.closest("form, section, [data-microfeed-search-scope]") ??
      input.parentElement;
    return scope?.querySelector<HTMLElement>("[data-microfeed-search-results]") ??
      null;
  }

  function message(container: HTMLElement, value: string): void {
    container.replaceChildren();
    const element = document.createElement("p");
    element.className = "mf-public-search-message";
    element.textContent = value;
    container.appendChild(element);
  }

  function showResults(container: HTMLElement, items: SearchResult[]): void {
    container.replaceChildren();
    if (items.length === 0) {
      message(container, "No results found.");
      return;
    }
    for (const item of items) {
      const link = document.createElement("a");
      link.className = "mf-public-search-result";
      link.href = item.url;
      const title = document.createElement("strong");
      title.textContent = item.title || "Untitled";
      const type = document.createElement("span");
      type.className = "mf-public-search-result__type";
      type.textContent = item.type;
      link.appendChild(title);
      link.appendChild(type);
      container.appendChild(link);
    }
  }

  async function search(input: HTMLInputElement): Promise<void> {
    const container = resultContainer(input);
    if (!container) return;
    const query = input.value.trim();
    if (query.length < 2) {
      message(container, query ? "Type one more character to search." : "Start typing to search.");
      return;
    }
    controller?.abort();
    controller = new AbortController();
    message(container, "Searching…");
    try {
      const url = new URL(endpoint, window.location.origin);
      url.searchParams.set("q", query);
      const response = await fetch(url, {
        headers: {accept: "application/json"},
        signal: controller.signal,
      });
      if (!response.ok) throw new Error("Search failed");
      const data = await response.json() as {items?: SearchResult[]};
      showResults(container, data.items ?? []);
    } catch (error) {
      if ((error as Error).name !== "AbortError") {
        message(container, "Search is temporarily unavailable.");
      }
    }
  }

  for (const input of document.querySelectorAll<HTMLInputElement>(
    "[data-microfeed-search-input]",
  )) {
    let timer: number | undefined;
    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void search(input), 150);
    });
    if (input.value.trim()) void search(input);
  }

  function openSearch(): void {
    if (!dialog) {
      window.location.assign("/search/");
      return;
    }
    if (!dialog.open) dialog.showModal();
    dialog.querySelector<HTMLInputElement>("[data-microfeed-search-input]")
      ?.focus();
  }

  for (const trigger of document.querySelectorAll<HTMLElement>(
    "[data-microfeed-search-open]",
  )) {
    trigger.addEventListener("click", openSearch);
  }
  dialog?.querySelector<HTMLElement>("[data-microfeed-search-close]")
    ?.addEventListener("click", () => dialog.close());
  dialog?.querySelector<HTMLInputElement>("[data-microfeed-search-input]")
    ?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.isComposing) return;
      event.preventDefault();
      (event.currentTarget as HTMLInputElement).form?.requestSubmit();
    });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
    if (event.key === "Escape" && dialog?.open) dialog.close();
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
