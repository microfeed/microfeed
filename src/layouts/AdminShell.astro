---
import {env} from "cloudflare:workers";
import "@fontsource-variable/geist";

import {normalizeAdminPath} from "@/shared/AdminPath";
import type {FeedContent, OnboardingResult} from "../types";
import "@/styles/admin.css";
import "../styles/interactive.css";

interface Props {
  feedContent: FeedContent;
  itemId?: string;
  onboardingResult: OnboardingResult;
  themeTemplate?: Record<string, unknown>;
  title: string;
}

const {
  feedContent,
  itemId,
  onboardingResult,
  themeTemplate,
  title,
} = Astro.props;
const adminPath = normalizeAdminPath(env.MICROFEED_ADMIN_PATH);
const safeJson = (value: unknown) =>
  JSON.stringify(value)
    .replaceAll("<", "\\u003c")
    .replaceAll(">", "\\u003e")
    .replaceAll("&", "\\u0026");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="microfeed-admin-path" content={adminPath} />
    <title>{title}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
  </head>
  <body>
    {itemId && <div id="lh-data-params" data-item-id={itemId}></div>}
    <script is:inline id="feed-content" type="application/json" set:html={safeJson(feedContent)}></script>
    <script is:inline id="onboarding-result" type="application/json" set:html={safeJson(onboardingResult)}></script>
    {themeTemplate && (
      <script is:inline id="theme-tmpl-json" type="application/json" set:html={safeJson(themeTemplate)}></script>
    )}
    <slot />
  </body>
</html>
