{
  "name": "microfeed",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "manage": "tsx manage-cli/index.ts",
    "dev": "yarn manage dev",
    "dev:astro": "astro dev",
    "migrate:local": "wrangler d1 migrations apply FEED_DB --local --config wrangler.jsonc",
    "types": "wrangler types src/worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck": "yarn types && astro check && tsc --noEmit",
    "lint:openapi": "node --import tsx scripts/lint-openapi.ts",
    "test": "TZ=UTC vitest run && TZ=UTC vitest run --config vitest.worker.config.ts",
    "build": "yarn types && astro build",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "docs:check": "astro check --root docs && yarn docs:build && node docs/scripts/check-build.mjs",
    "docs:upload-preview": "yarn docs:check && wrangler deploy --strict --env preview --config docs/wrangler.jsonc",
    "docs:deploy": "yarn docs:check && wrangler deploy --strict --env=\"\" --config docs/wrangler.jsonc",
    "check": "yarn lint:openapi && yarn typecheck && yarn test && yarn build && wrangler deploy --dry-run --strict --config dist/server/wrangler.json && yarn docs:check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.6.0",
    "@clack/prompts": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@scalar/api-reference-react": "^0.9.60",
    "@tanstack/react-table": "^8.5.28",
    "@uiw/react-textarea-code-editor": "^2.1.9",
    "axios": "^1.19.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "cropperjs": "^1.5.12",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.27.0",
    "lz-string": "^1.4.4",
    "mustache": "^4.2.0",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.16.0",
    "slugify": "^1.6.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "0.41.6",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@redocly/cli": "^2.44.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "astro": "^7.1.6",
    "miniflare": "4.20260722.1",
    "postcss": "^8.5.25",
    "starlight-llms-txt": "^0.11.0",
    "tailwind-gradient-mask-image": "^1.0.0",
    "tailwindcss": "^4.0.14",
    "tar": "^7.4.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
