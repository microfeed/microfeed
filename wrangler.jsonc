{
  // Build and type-generation defaults only. `yarn manage` generates and uses
  // a complete per-installation Wrangler configuration for every deployment.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microfeed",
  "workers_dev": true,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "FEED_DB",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET"
    }
  ],
  "routes": []
}
