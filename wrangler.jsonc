{
  // Build and type-generation defaults only. `yarn manage` generates and uses
  // a complete per-installation Wrangler configuration for every deployment.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "microfeed",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "secrets": {
    "required": ["UPLOAD_SIGNING_KEY", "BETTER_AUTH_SECRET", "WEBHOOK_SECRET_KEY"]
  },
  "d1_databases": [
    {
      "binding": "FEED_DB",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "microfeed-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "microfeed-webhooks",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": []
}
