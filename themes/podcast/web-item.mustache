<main class="pod-main pod-item-main">
  <a class="pod-back" href="/">← All episodes</a>
  <article class="pod-item">
    <div class="pod-item-art">
      {{#items.0.image}}<img src="{{items.0.image}}" alt="" loading="eager" />{{/items.0.image}}
      {{^items.0.image}}{{#icon}}<img src="{{icon}}" alt="{{title}} cover art" loading="eager" />{{/icon}}{{/items.0.image}}
    </div>
    <div class="pod-item-intro">
      <p class="pod-kicker">Episode</p>
      <h1>{{items.0.title}}</h1>
      <div class="pod-episode-meta">
        <time>{{items.0._microfeed.date_published_short}}</time>
        {{#items.0._microfeed.duration_hhmmss}}<span>{{items.0._microfeed.duration_hhmmss}}</span>{{/items.0._microfeed.duration_hhmmss}}
        {{#items.0._microfeed.itunes:season}}<span>S{{items.0._microfeed.itunes:season}}</span>{{/items.0._microfeed.itunes:season}}
        {{#items.0._microfeed.itunes:episode}}<span>E{{items.0._microfeed.itunes:episode}}</span>{{/items.0._microfeed.itunes:episode}}
      </div>
      {{#items.0._microfeed.is_audio}}{{#items.0.attachments}}<audio class="pod-feature-player" controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/items.0.attachments}}{{/items.0._microfeed.is_audio}}
      {{#items.0._microfeed.is_video}}{{#items.0.attachments}}<video class="pod-feature-video" controls preload="metadata" poster="{{items.0.image}}"><source src="{{url}}" type="{{mime_type}}" />Your browser does not support video.</video>{{/items.0.attachments}}{{/items.0._microfeed.is_video}}
      {{#items.0._microfeed.is_image}}{{#items.0.attachments}}<a class="pod-feature-image" href="{{url}}"><img src="{{url}}" alt="" loading="eager" /></a>{{/items.0.attachments}}{{/items.0._microfeed.is_image}}
      {{#items.0._microfeed.is_document}}{{#items.0.attachments}}<a class="pod-action" href="{{url}}">Download the companion file →</a>{{/items.0.attachments}}{{/items.0._microfeed.is_document}}
      {{#items.0._microfeed.is_external_url}}{{#items.0.attachments}}<a class="pod-action" href="{{url}}" rel="noopener nofollow">Visit the referenced site →</a>{{/items.0.attachments}}{{/items.0._microfeed.is_external_url}}
    </div>
    <div class="pod-show-notes">
      <h2>Show notes</h2>
      {{#items.0.content_html}}<div class="pod-rich-content">{{{items.0.content_html}}}</div>{{/items.0.content_html}}
      {{^items.0.content_html}}<p>{{items.0.content_text}}</p>{{/items.0.content_html}}
    </div>
    <aside class="pod-item-subscribe">
      <strong>Keep listening</strong>
      <p>Follow {{title}} in your preferred reader.</p>
      <div class="pod-subscribe">{{#_microfeed.subscribe_methods}}<a href="{{url}}"><span>{{name}}</span></a>{{/_microfeed.subscribe_methods}}</div>
    </aside>
  </article>
</main>
