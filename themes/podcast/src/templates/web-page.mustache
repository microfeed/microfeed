<main class="pod-main pod-prose-main">
  <a class="pod-back" href="/">← {{title}}</a>
  <article class="pod-page{{#page.is_not_found_page}} pod-page-not-found{{/page.is_not_found_page}}">
    {{#page.is_not_found_page}}<p class="pod-kicker">404 · Off air</p>{{/page.is_not_found_page}}
    <h1>{{page.title}}</h1>
    <div class="pod-rich-content">{{{page.content_html}}}</div>
  </article>
</main>
