<main class="blog-main blog-reader">
  <a class="blog-back" href="/">← {{title}}</a>
  <article class="blog-page{{#page.is_not_found_page}} blog-page-not-found{{/page.is_not_found_page}}">
    {{#page.is_not_found_page}}<p class="blog-rubric">Page 404</p>{{/page.is_not_found_page}}
    <h1>{{page.title}}</h1>
    <div class="blog-rich-content">{{{page.content_html}}}</div>
  </article>
</main>
