<main>
  <a class="mf-back-link" href="/">&larr; Home</a>
  <section class="mf-search-page">
    <h1>Search</h1>
    <form action="/search/" method="get" class="mf-search-page-form" role="search" data-microfeed-search-scope>
      <label class="mf-visually-hidden" for="microfeed-search-page-input">Search this site</label>
      <div class="mf-search-control">
        <input id="microfeed-search-page-input" name="q" type="search" placeholder="Search items and pages" value="{{search.query}}" autocomplete="off" data-microfeed-search-input />
        <button type="submit">Search</button>
      </div>
      <div aria-live="polite" data-microfeed-search-results data-microfeed-search-details></div>
    </form>
  </section>
</main>
