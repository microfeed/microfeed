<main class="mf-shell py-10 sm:py-16">
  <section class="grid gap-8 border-b border-mf-border pb-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
    <div>
      <p class="mf-kicker">Independent publishing</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-black leading-[.96] tracking-[-.045em] sm:text-6xl lg:text-7xl">{{title}}</h1>
    </div>
    {{#description}}<p class="text-base leading-7 text-mf-muted lg:text-lg">{{description}}</p>{{/description}}
  </section>

  <section class="py-10" aria-labelledby="latest-heading">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div><p class="mf-kicker">New dispatches</p><h2 id="latest-heading" class="mt-1 text-2xl font-black tracking-tight sm:text-3xl">Latest</h2></div>
    </div>
    {{#items.length}}
    <div class="grid gap-6 lg:grid-cols-2">
      {{#items}}
      <article class="group overflow-hidden rounded-2xl border border-mf-border bg-mf-surface transition hover:-translate-y-1 hover:border-mf-accent hover:shadow-xl">
        {{#image}}<a href="{{url}}"><img class="aspect-[16/9] w-full object-cover" src="{{image}}" alt=""></a>{{/image}}
        {{^image}}{{#banner_image}}<a href="{{url}}"><img class="aspect-[16/9] w-full object-cover" src="{{banner_image}}" alt=""></a>{{/banner_image}}{{/image}}
        <div class="p-6 sm:p-8">
          {{#_microfeed.date_published_short}}<p class="mf-kicker">{{_microfeed.date_published_short}}</p>{{/_microfeed.date_published_short}}
          <h3 class="mt-2 text-2xl font-black leading-tight tracking-tight sm:text-3xl"><a class="no-underline transition group-hover:text-mf-accent" href="{{url}}">{{title}}</a></h3>
          {{#content_text}}<p class="mt-4 line-clamp-3 leading-7 text-mf-muted">{{content_text}}</p>{{/content_text}}
          <a class="mt-6 inline-flex font-bold text-mf-accent no-underline" href="{{url}}">Read story <span aria-hidden="true">→</span></a>
        </div>
      </article>
      {{/items}}
    </div>
    {{/items.length}}
    {{^items.length}}<div class="rounded-2xl border border-dashed border-mf-border bg-mf-surface px-6 py-20 text-center"><h3 class="text-xl font-black">No stories yet</h3><p class="mt-2 text-mf-muted">The first dispatch will appear here when it is published.</p></div>{{/items.length}}
  </section>

  {{#_microfeed.prev_url}}<nav class="flex flex-wrap justify-between gap-3 border-t border-mf-border pt-7" aria-label="Pagination"><a class="rounded-full border border-mf-border px-5 py-3 font-bold no-underline hover:border-mf-accent hover:text-mf-accent" href="{{_microfeed.prev_url}}">← Newer</a>{{#_microfeed.next_url}}<a class="ml-auto rounded-full border border-mf-border px-5 py-3 font-bold no-underline hover:border-mf-accent hover:text-mf-accent" href="{{_microfeed.next_url}}">Older →</a>{{/_microfeed.next_url}}</nav>{{/_microfeed.prev_url}}
  {{^_microfeed.prev_url}}{{#_microfeed.next_url}}<nav class="flex justify-end border-t border-mf-border pt-7" aria-label="Pagination"><a class="rounded-full border border-mf-border px-5 py-3 font-bold no-underline hover:border-mf-accent hover:text-mf-accent" href="{{_microfeed.next_url}}">Older →</a></nav>{{/_microfeed.next_url}}{{/_microfeed.prev_url}}
</main>
