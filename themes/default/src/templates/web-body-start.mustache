<header class="border-b border-mf-border bg-mf-background">
  <div class="mf-shell flex min-h-20 items-center justify-between gap-4 py-4">
    <a class="flex min-w-0 items-center gap-3 no-underline" href="{{home_page_url}}" aria-label="{{title}} home">
      {{#icon}}<img class="size-10 rounded-xl object-cover" src="{{icon}}" alt="">{{/icon}}
      <span class="truncate text-xl font-black tracking-tight">{{title}}</span>
    </a>
    <div class="flex items-center gap-2">
      {{#feed_url}}<a class="rounded-full border border-mf-border px-4 py-2 text-sm font-bold no-underline transition hover:border-mf-accent hover:text-mf-accent" href="{{feed_url}}">RSS</a>{{/feed_url}}
      <button class="cursor-pointer rounded-full border border-mf-border bg-mf-surface px-4 py-2 text-sm font-bold transition hover:border-mf-accent hover:text-mf-accent" type="button" data-action="theme"><span data-theme-label>Dark</span></button>
    </div>
  </div>
</header>
