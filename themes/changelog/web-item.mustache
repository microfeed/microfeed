<main class="chg-main chg-prose-main"><a class="chg-back" href="/">← All updates</a><article class="chg-item"><header><div class="chg-item-date"><span aria-hidden="true"></span><time>{{items.0._microfeed.date_published_short}}</time></div><p class="chg-kicker">Product update</p><h1>{{items.0.title}}</h1><div class="chg-item-meta">{{#items.0.authors}}<span>By {{name}}</span>{{/items.0.authors}}{{#items.0._microfeed.duration_hhmmss}}<span>{{items.0._microfeed.duration_hhmmss}}</span>{{/items.0._microfeed.duration_hhmmss}}</div></header>{{#items.0.image}}<img class="chg-feature" src="{{items.0.image}}" alt="" loading="eager" />{{/items.0.image}}<div class="chg-prose">{{#items.0.content_html}}{{{items.0.content_html}}}{{/items.0.content_html}}{{^items.0.content_html}}<p>{{items.0.content_text}}</p>{{/items.0.content_html}}
  {{#items.0._microfeed.is_video}}{{#items.0.attachments}}<video controls preload="metadata" poster="{{items.0.image}}"><source src="{{url}}" type="{{mime_type}}" /></video>{{/items.0.attachments}}{{/items.0._microfeed.is_video}}
  {{#items.0._microfeed.is_audio}}{{#items.0.attachments}}<audio controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/items.0.attachments}}{{/items.0._microfeed.is_audio}}
  {{#items.0._microfeed.is_image}}{{#items.0.attachments}}<p><a href="{{url}}">Open supporting image →</a></p>{{/items.0.attachments}}{{/items.0._microfeed.is_image}}
  {{#items.0._microfeed.is_document}}{{#items.0.attachments}}<p><a class="chg-primary" href="{{url}}">Download migration guide →</a></p>{{/items.0.attachments}}{{/items.0._microfeed.is_document}}
  {{#items.0._microfeed.is_external_url}}{{#items.0.attachments}}<p><a class="chg-primary" href="{{url}}" rel="noopener nofollow">Open related resource →</a></p>{{/items.0.attachments}}{{/items.0._microfeed.is_external_url}}
  </div></article></main>
