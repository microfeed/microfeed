<main class="chg-main"><section class="chg-intro"><div><p class="chg-kicker">Product changelog</p><h1>{{title}}</h1></div><div>{{#description}}<div class="chg-description">{{{description}}}</div>{{/description}}<p>{{#authors}}Written by {{name}}{{/authors}}</p><div class="chg-subscribe">{{#_microfeed.subscribe_methods}}<a href="{{url}}">{{name}}</a>{{/_microfeed.subscribe_methods}}</div></div></section><section class="chg-stream" aria-labelledby="chg-latest"><div class="chg-heading"><h2 id="chg-latest">Latest changes</h2><div><span><i class="chg-dot chg-dot-launch"></i>Launch</span><span><i class="chg-dot chg-dot-improve"></i>Improvement</span><span><i class="chg-dot chg-dot-fix"></i>Fix</span></div></div>
  {{^items.length}}<div class="chg-empty"><strong>No updates yet.</strong><p>The first meaningful product change will appear here.</p></div>{{/items.length}}
  <div class="chg-timeline">{{#items}}<article class="chg-entry"><div class="chg-date"><time>{{_microfeed.date_published_short}}</time><span aria-hidden="true"></span></div><div class="chg-entry-copy"><p class="chg-label">Product update</p><h3><a href="{{_microfeed.web_url}}">{{title}}</a></h3>{{#content_text}}<p>{{content_text}}</p>{{/content_text}}<div class="chg-actions"><a href="{{_microfeed.web_url}}">Read release notes →</a>{{#_microfeed.duration_hhmmss}}<span>{{_microfeed.duration_hhmmss}}</span>{{/_microfeed.duration_hhmmss}}</div>{{#_microfeed.is_video}}{{#attachments}}<video controls preload="metadata" poster="{{image}}"><source src="{{url}}" type="{{mime_type}}" /></video>{{/attachments}}{{/_microfeed.is_video}}{{#_microfeed.is_audio}}{{#attachments}}<audio controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/attachments}}{{/_microfeed.is_audio}}</div>{{#image}}<a class="chg-visual" href="{{_microfeed.web_url}}"><img src="{{image}}" alt="" loading="lazy" /></a>{{/image}}</article>{{/items}}</div>
  <nav class="chg-pagination" aria-label="Pagination">{{#_microfeed.prev_url}}<a href="{{_microfeed.prev_url}}">← Newer</a>{{/_microfeed.prev_url}}{{#_microfeed.next_url}}<a href="{{_microfeed.next_url}}">Older updates →</a>{{/_microfeed.next_url}}</nav>
</section></main>
