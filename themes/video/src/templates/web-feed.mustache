<main class="vid-main">
  <section class="vid-intro"><div><p class="vid-eyebrow">Independent films · New releases</p><h1>{{title}}</h1></div><div>{{#description}}<div class="vid-description">{{{description}}}</div>{{/description}}<p class="vid-byline">{{#authors}}Films by {{name}}{{/authors}}</p><div class="vid-subscribe">{{#_microfeed.subscribe_methods}}<a href="{{url}}">{{name}}</a>{{/_microfeed.subscribe_methods}}</div></div></section>
  <section class="vid-library" aria-labelledby="vid-latest"><div class="vid-section-title"><h2 id="vid-latest">Now showing</h2><span>Open a film for theater view</span></div>
    {{^items.length}}<div class="vid-empty"><span aria-hidden="true">□</span><h3>The screen is quiet</h3><p>New films will appear here when published.</p></div>{{/items.length}}
    <div class="vid-grid">{{#items}}<article class="vid-card"><a class="vid-poster" href="{{_microfeed.web_url}}">{{#image}}<img src="{{image}}" alt="" loading="lazy" />{{/image}}{{^image}}<span aria-hidden="true">▶</span>{{/image}}<span class="vid-play" aria-hidden="true">▶</span>{{#_microfeed.duration_hhmmss}}<span class="vid-duration">{{_microfeed.duration_hhmmss}}</span>{{/_microfeed.duration_hhmmss}}</a><div class="vid-card-copy"><div class="vid-meta"><time>{{_microfeed.date_published_short}}</time>{{#_microfeed.is_video}}<span>Film</span>{{/_microfeed.is_video}}{{#_microfeed.is_audio}}<span>Audio</span>{{/_microfeed.is_audio}}{{#_microfeed.is_image}}<span>Stills</span>{{/_microfeed.is_image}}{{#_microfeed.is_document}}<span>Guide</span>{{/_microfeed.is_document}}</div><h3><a href="{{_microfeed.web_url}}">{{title}}</a></h3>{{#content_text}}<p>{{content_text}}</p>{{/content_text}}</div></article>{{/items}}</div>
    <nav class="vid-pagination" aria-label="Pagination">{{#_microfeed.prev_url}}<a href="{{_microfeed.prev_url}}">← Newer</a>{{/_microfeed.prev_url}}{{#_microfeed.next_url}}<a href="{{_microfeed.next_url}}">Older films →</a>{{/_microfeed.next_url}}</nav>
  </section>
</main>
