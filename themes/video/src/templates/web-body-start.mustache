<header class="vid-shell">
  <a class="vid-brand" href="/" aria-label="{{title}} home"><span aria-hidden="true">▶</span><strong>{{title}}</strong></a>
  <nav class="vid-nav" aria-label="Site navigation">{{#navigation_pages}}<a href="{{url}}" data-microfeed-nav-item>{{navigation_label}}</a>{{/navigation_pages}}</nav>
  <button class="vid-search" type="button" aria-haspopup="dialog" aria-controls="microfeed-search-dialog" data-microfeed-search-open><span aria-hidden="true">⌕</span><span>Search</span></button>
  <details class="vid-theme" data-theme-menu><summary aria-label="Choose color theme">◐</summary><div role="menu" aria-label="Color theme"><button type="button" role="menuitemradio" aria-checked="true" data-theme-option="system">System</button><button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light">Light</button><button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark">Dark</button></div></details>
</header>
