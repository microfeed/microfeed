<main class="vid-main vid-item-main"><a class="vid-back" href="/">← All films</a><article class="vid-item"><div class="vid-theater">
  {{#items.0._microfeed.is_video}}{{#items.0.attachments}}<video controls preload="metadata" poster="{{items.0.image}}"><source src="{{url}}" type="{{mime_type}}" />Your browser does not support video.</video>{{/items.0.attachments}}{{/items.0._microfeed.is_video}}
  {{^items.0._microfeed.is_video}}{{#items.0.image}}<img src="{{items.0.image}}" alt="" loading="eager" />{{/items.0.image}}{{^items.0.image}}<div class="vid-theater-empty" aria-hidden="true">▶</div>{{/items.0.image}}{{/items.0._microfeed.is_video}}
  </div><div class="vid-item-layout"><header><p class="vid-eyebrow">Lumen original</p><h1>{{items.0.title}}</h1><div class="vid-meta"><time>{{items.0._microfeed.date_published_short}}</time>{{#items.0._microfeed.duration_hhmmss}}<span>{{items.0._microfeed.duration_hhmmss}}</span>{{/items.0._microfeed.duration_hhmmss}}{{#items.0.authors}}<span>By {{name}}</span>{{/items.0.authors}}</div></header><div class="vid-notes"><h2>About this release</h2>{{#items.0.content_html}}<div class="vid-prose">{{{items.0.content_html}}}</div>{{/items.0.content_html}}{{^items.0.content_html}}<p>{{items.0.content_text}}</p>{{/items.0.content_html}}
  {{#items.0._microfeed.is_audio}}{{#items.0.attachments}}<audio controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/items.0.attachments}}{{/items.0._microfeed.is_audio}}
  {{#items.0._microfeed.is_image}}{{#items.0.attachments}}<a class="vid-action" href="{{url}}">Open full-resolution image →</a>{{/items.0.attachments}}{{/items.0._microfeed.is_image}}
  {{#items.0._microfeed.is_document}}{{#items.0.attachments}}<a class="vid-action" href="{{url}}">Download production file →</a>{{/items.0.attachments}}{{/items.0._microfeed.is_document}}
  {{#items.0._microfeed.is_external_url}}{{#items.0.attachments}}<a class="vid-action" href="{{url}}" rel="noopener nofollow">Open original source →</a>{{/items.0.attachments}}{{/items.0._microfeed.is_external_url}}
  </div></div></article></main>
