<header class="photo-shell">
  <a class="photo-brand" href="/" aria-label="{{title}} home"><span aria-hidden="true">□</span>{{title}}</a>
  <nav class="photo-nav" aria-label="Site navigation">{{#navigation_pages}}<a href="{{url}}" data-microfeed-nav-item>{{navigation_label}}</a>{{/navigation_pages}}</nav>
  <button type="button" class="photo-search-open" aria-label="Search this site" aria-haspopup="dialog" aria-controls="microfeed-search-dialog" data-microfeed-search-open>⌕</button>
  <details class="photo-theme-menu" data-theme-menu>
    <summary aria-label="Choose color theme">◑</summary>
    <div role="menu" aria-label="Color theme">
      <button type="button" role="menuitemradio" aria-checked="true" data-theme-option="system">System</button>
      <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light">Light</button>
      <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark">Dark</button>
    </div>
  </details>
</header>
