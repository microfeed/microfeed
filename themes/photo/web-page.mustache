<main class="photo-main photo-prose-main">
  <a class="photo-back" href="/">← {{title}}</a>
  <article class="photo-page{{#page.is_not_found_page}} photo-page-not-found{{/page.is_not_found_page}}">
    {{#page.is_not_found_page}}<p class="photo-kicker">Missing frame · 404</p>{{/page.is_not_found_page}}
    <h1>{{page.title}}</h1>
    <div class="photo-rich-content">{{{page.content_html}}}</div>
  </article>
</main>
