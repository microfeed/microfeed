<header class="dig-shell"><a class="dig-brand" href="/" aria-label="{{title}} home"><span aria-hidden="true">⌁</span><strong>{{title}}</strong></a><nav class="dig-nav" aria-label="Site navigation"><a href="/tags/" data-microfeed-nav-item{{#tags_active}} aria-current="page"{{/tags_active}}>Tags</a>
    {{#navigation_pages}}<a href="{{url}}" data-microfeed-nav-item>{{navigation_label}}</a>{{/navigation_pages}}</nav><button class="dig-search" type="button" aria-haspopup="dialog" aria-controls="microfeed-search-dialog" data-microfeed-search-open>Search <span aria-hidden="true">⌘K</span></button><details class="dig-theme" data-theme-menu><summary aria-label="Choose color theme">◐</summary><div role="menu" aria-label="Color theme"><button type="button" role="menuitemradio" aria-checked="true" data-theme-option="system">System</button><button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light">Light</button><button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark">Dark</button></div></details></header>
