<main class="dig-main"><section class="dig-intro"><p class="dig-kicker">A human-made reading list</p><h1>{{title}}</h1><div class="dig-intro-grid">{{#description}}<div class="dig-description">{{{description}}}</div>{{/description}}<div><p>{{#authors}}Curated by {{name}}{{/authors}}</p><div class="dig-subscribe">{{#_microfeed.subscribe_methods}}<a href="{{url}}">{{name}}</a>{{/_microfeed.subscribe_methods}}</div></div></div></section><section class="dig-links" aria-labelledby="dig-latest"><div class="dig-heading"><h2 id="dig-latest">This week’s margins</h2><span>Original destinations open directly</span></div>
  {{^items.length}}<div class="dig-empty"><strong>Nothing clipped yet.</strong><p>The next useful link will appear here.</p></div>{{/items.length}}
  <div class="dig-list">{{#items}}<article class="dig-card"><div class="dig-source"><span>Saved</span>{{#authors}}<strong>{{name}}</strong>{{/authors}}<time>{{_microfeed.date_published_short}}</time></div><div class="dig-copy"><h3><a href="{{#attachments}}{{url}}{{/attachments}}{{^attachments}}{{_microfeed.web_url}}{{/attachments}}">{{title}} <span aria-hidden="true">↗</span></a></h3>{{#content_text}}<p>{{content_text}}</p>{{/content_text}}<div class="dig-actions">{{#attachments}}<a href="{{url}}" rel="noopener nofollow">Open original ↗</a>{{/attachments}}<a href="{{_microfeed.web_url}}">Read annotation</a></div>{{#_microfeed.is_audio}}{{#attachments}}<audio controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/attachments}}{{/_microfeed.is_audio}}{{#_microfeed.is_video}}{{#attachments}}<video controls preload="metadata" poster="{{image}}"><source src="{{url}}" type="{{mime_type}}" /></video>{{/attachments}}{{/_microfeed.is_video}}</div>{{#image}}<a class="dig-thumb" href="{{#attachments}}{{url}}{{/attachments}}"><img src="{{image}}" alt="" loading="lazy" /></a>{{/image}}</article>{{/items}}</div>
  <nav class="dig-pagination" aria-label="Pagination">{{#_microfeed.prev_url}}<a href="{{_microfeed.prev_url}}">← Newer</a>{{/_microfeed.prev_url}}{{#_microfeed.next_url}}<a href="{{_microfeed.next_url}}">Older links →</a>{{/_microfeed.next_url}}</nav>
</section></main>
