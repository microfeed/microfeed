<main class="dig-main dig-prose-main"><a class="dig-back" href="/">← All links</a><article class="dig-item"><header><p class="dig-kicker">Editor’s margin note</p><h1>{{items.0.title}}</h1><div class="dig-item-meta"><time>{{items.0._microfeed.date_published_short}}</time>{{#items.0.authors}}<span>Source: {{name}}</span>{{/items.0.authors}}</div>{{#items.0.attachments}}<a class="dig-primary" href="{{url}}" rel="noopener nofollow">Open original destination ↗</a>{{/items.0.attachments}}</header>{{#items.0.image}}<img class="dig-feature" src="{{items.0.image}}" alt="" loading="eager" />{{/items.0.image}}<div class="dig-prose">{{#items.0.content_html}}{{{items.0.content_html}}}{{/items.0.content_html}}{{^items.0.content_html}}<p>{{items.0.content_text}}</p>{{/items.0.content_html}}
  {{#items.0._microfeed.is_audio}}{{#items.0.attachments}}<audio controls preload="metadata" src="{{url}}">Your browser does not support audio.</audio>{{/items.0.attachments}}{{/items.0._microfeed.is_audio}}
  {{#items.0._microfeed.is_video}}{{#items.0.attachments}}<video controls preload="metadata" poster="{{items.0.image}}"><source src="{{url}}" type="{{mime_type}}" /></video>{{/items.0.attachments}}{{/items.0._microfeed.is_video}}
  {{#items.0._microfeed.is_image}}{{#items.0.attachments}}<p><a href="{{url}}">Open full image ↗</a></p>{{/items.0.attachments}}{{/items.0._microfeed.is_image}}
  {{#items.0._microfeed.is_document}}{{#items.0.attachments}}<p><a href="{{url}}">Open document ↗</a></p>{{/items.0.attachments}}{{/items.0._microfeed.is_document}}
  </div></article></main>
